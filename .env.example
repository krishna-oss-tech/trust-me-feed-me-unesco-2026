# ============================================================
# TRUST ME, FEED ME — UNESCO Youth Hackathon 2026
# "What you trust shapes what you see."
# ============================================================

# Server-Side AI Secret (Used exclusively in Vercel Serverless Function /api/ai-analysis)
# NEVER use VITE_ prefix for this secret key!
# Set this in your Vercel Project Settings -> Environment Variables.
# Supported: OpenAI API Key (or OpenAI-compatible endpoint)
AI_API_KEY=your_server_side_ai_key_here

# Optional Client-Side Public Supabase Configuration (Anonymous Session Persistence)
# Safe to expose publicly when Row Level Security (RLS) is enabled on Supabase table.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
